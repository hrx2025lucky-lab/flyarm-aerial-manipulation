<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     flyarm  -  空中机械臂 (四旋翼 + 4 自由度机械臂 + 二指夹爪)
     由 SolidWorks 导出 (Stephen Brawner sw_urdf_exporter)。

     针对 IsaacLab / MuJoCo 仿真所做的修改:
       1. 修复卡死的旋翼: rr_rotor_joint 由 fixed / axis "0 0 0" 改为 continuous / "-1 0 0"
       2. 机械臂连杆/关节重命名为可读名称 (对照表见下)。
       3. 四个旋翼重命名: l22/l33/l44/l55 -> rr/fr/fl/rl_rotor (x前 y左 约定)
       4. 统一网格包路径: "package://arm/..." -> "package://flyarm/..."
       5. 机械臂自由度关节由 continuous 改为带角度限位的 revolute。
       6. D 轴 (腕) 限位收紧到 ±0.1 rad (近似固定腕)。

     机械臂命名对照 (旧 -> 新):
       l1 -> arm_base          (机械臂固定底座, fixed mount)
       l2 -> arm_base_rotate   (旋转底座)        joint: base_rotate_joint
       l3 -> link_bc           (BC 轴连杆)       joint: axis_B_joint
       l4 -> link_cd           (CD 轴连杆)       joint: axis_C_joint
       l5 -> gripper_base      (夹爪底座)        joint: axis_D_joint
       l6 -> gripper_right     (右夹爪)          joint: gripper_right_joint
       l7 -> gripper_left      (左夹爪)          joint: gripper_left_joint

     旋翼命名对照 (旧 -> 新, 按安装位置 x前/y左):
       l22 (-x,-y) -> rr_rotor  joint: rr_rotor_joint   (右后)
       l33 (+x,-y) -> fr_rotor  joint: fr_rotor_joint   (右前)
       l44 (+x,+y) -> fl_rotor  joint: fl_rotor_joint   (左前)
       l55 (-x,+y) -> rl_rotor  joint: rl_rotor_joint   (左后)

     说明: 仿真请用 flyarm_sim.urdf (相对 mesh 路径)。本文件用 package:// 供网页查看器。
     <limit> 数值是占位安全值, 训练前按真实舵机行程收紧。
     ============================================================================ -->
<robot
  name="flyarm">

  <!-- ======================= 机体 ======================= -->
  <link
    name="base_link">
    <inertial>
      <origin
        xyz="0.000351127786367396 -0.000257429115357956 -0.0335575170333576"
        rpy="0 0 0" />
      <!-- base_link 质量取真机机架实测值 2.0kg。惯量按质量比缩放 (假设质量分布不变, 上真机前用 CAD 精标)。 -->
      <mass
        value="2.0" />
      <inertia
        ixx="0.00278714"
        ixy="2.60343E-06"
        ixz="2.46949E-08"
        iyy="0.00136146"
        iyz="2.65360E-06"
        izz="0.00305334" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="../meshes/base_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <!-- 保留 base_link 碰撞。脚架离地不靠去掉碰撞实现, 而是靠"直臂 (arm_straight) + 高悬停 (hover_offset)"
         → 无人机不下降 → 脚架不触地。保留物理脚架更接近真机并作为安全网。 -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="../meshes/base_link.STL" /></geometry>
    </collision>
  </link>

  <!-- ======================= 旋翼 (×4) =======================
       四个旋翼自由旋转 (continuous)。升力/反扭由飞控在仿真里施加, 关节轴只是可视化旋转轴。 -->
  <!-- 右后 rr_rotor (原 l22) -->
  <link
    name="rr_rotor">
    <inertial>
      <origin
        xyz="0.0473353347145848 0.000197095936702529 0.000174051578952034"
        rpy="0 0 0" />
      <mass
        value="0.0229282927851813" />
      <inertia
        ixx="9.09087806405936E-05"
        ixy="5.13488235782876E-10"
        ixz="-1.07369138950175E-09"
        iyy="5.57789393210295E-05"
        iyz="4.31406386140824E-05"
        izz="3.5909689375767E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="../meshes/rr_rotor.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="../meshes/rr_rotor.STL" />
      </geometry>
    </collision>
  </link>
  <!-- 修正: 原来是 fixed / axis="0 0 0" (该旋翼转不了), 现改为 continuous -->
  <joint
    name="rr_rotor_joint"
    type="continuous">
    <origin
      xyz="-0.170163131133237 -0.170201542587365 0.0708"
      rpy="1.5707963267949 -1.5707963267949 0" />
    <parent
      link="base_link" />
    <child
      link="rr_rotor" />
    <axis
      xyz="-1 0 0" />
  </joint>

  <!-- 右前 fr_rotor (原 l33) -->
  <link
    name="fr_rotor">
    <inertial>
      <origin
        xyz="0.0473275810559199 -0.000467343845156593 -0.000751366737984482"
        rpy="0 0 0" />
      <mass
        value="0.0229273353251971" />
      <inertia
        ixx="9.08987166445279E-05"
        ixy="-9.4681308528274E-07"
        ixz="-3.211560706351E-08"
        iyy="1.64331076850008E-06"
        iyz="-2.2803035789249E-06"
        izz="9.00554487876853E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="../meshes/fr_rotor.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="../meshes/fr_rotor.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="fr_rotor_joint"
    type="continuous">
    <origin
      xyz="0.168176808521089 -0.168048450980534 0.0707991465916544"
      rpy="1.5707963267949 -1.5707963267949 0" />
    <parent
      link="base_link" />
    <child
      link="fr_rotor" />
    <axis
      xyz="-1 0 0" />
  </joint>

  <!-- 左前 fl_rotor (原 l44) -->
  <link
    name="fl_rotor">
    <inertial>
      <origin
        xyz="0.0473353117833849 0.000202037047005471 -0.000168240650222473"
        rpy="0 0 0" />
      <mass
        value="0.0229281784444268" />
      <inertia
        ixx="9.09077649282057E-05"
        ixy="-9.74921530361897E-10"
        ixz="-6.67623680368692E-10"
        iyy="4.93864891618474E-05"
        iyz="-4.41273182457583E-05"
        izz="4.23011092928309E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="../meshes/fl_rotor.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="../meshes/fl_rotor.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="fl_rotor_joint"
    type="continuous">
    <origin
      xyz="0.170164649982814 0.17012623852867 0.0708"
      rpy="1.5707963267949 -1.5707963267949 0" />
    <parent
      link="base_link" />
    <child
      link="fl_rotor" />
    <axis
      xyz="-1 0 0" />
  </joint>

  <!-- 左后 rl_rotor (原 l55) -->
  <link
    name="rl_rotor">
    <inertial>
      <origin
        xyz="0.0473351076739079 -0.000259129949975956 4.45263675536989E-05"
        rpy="0 0 0" />
      <mass
        value="0.0229274907678625" />
      <inertia
        ixx="9.09084868706134E-05"
        ixy="5.14458621610906E-10"
        ixz="1.07562148698373E-09"
        iyy="8.5845577951234E-05"
        iyz="-1.89654922420876E-05"
        izz="5.842688609076E-06" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="../meshes/rl_rotor.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="../meshes/rl_rotor.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="rl_rotor_joint"
    type="continuous">
    <origin
      xyz="-0.170871594249042 0.170834701644432 0.0708"
      rpy="1.5707963267949 -1.5707963267949 0" />
    <parent
      link="base_link" />
    <child
      link="rl_rotor" />
    <axis
      xyz="-1 0 0" />
  </joint>

  <!-- ======================= 机械臂 =======================
       链: base_link -(arm_mount)-> arm_base -(base_rotate)-> arm_base_rotate
           -(axis_B)-> link_bc -(axis_C)-> link_cd -(axis_D)-> gripper_base
           -(gripper_right / gripper_left)-> 两指
       关节正方向沿 axis="-1 0 0" (绕局部 -X)。 -->

  <!-- l1 : 机械臂固定底座 (固连在无人机下方) -->
  <link
    name="arm_base">
    <inertial>
      <origin
        xyz="-0.0083485309775336 0.000154996776270776 0.0259797943306873"
        rpy="0 0 0" />
      <mass
        value="0.272894323468001" />
      <inertia
        ixx="0.000188019850509716"
        ixy="2.3204599431514E-07"
        ixz="1.45801251226452E-05"
        iyy="0.000210926622774998"
        iyz="-1.06345721979206E-07"
        izz="0.000310160657895025" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="../meshes/arm_base.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.776470588235294 0.756862745098039 0.737254901960784 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="../meshes/arm_base.STL" />
      </geometry>
    </collision>
  </link>
  <!-- j00 : 机械臂刚性固连到机体 -->
  <joint
    name="arm_mount_joint"
    type="fixed">
    <origin
      xyz="0 0 0"
      rpy="3.14 0 -1.57" />
    <parent
      link="base_link" />
    <child
      link="arm_base" />
    <axis
      xyz="0 0 0" />
  </joint>

  <!-- l2 : 旋转底座 -->
  <link
    name="arm_base_rotate">
    <inertial>
      <origin
        xyz="0.0359439762293015 -0.00713462357357059 -0.00308284931111787"
        rpy="0 0 0" />
      <mass
        value="0.191533351388813" />
      <inertia
        ixx="0.000107090640010156"
        ixy="9.5354041509615E-07"
        ixz="-4.44253031875453E-06"
        iyy="0.000134604517947024"
        iyz="9.66928729492876E-06"
        izz="0.000116154179587917" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="../meshes/arm_base_rotate.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.776470588235294 0.756862745098039 0.737254901960784 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="../meshes/arm_base_rotate.STL" />
      </geometry>
    </collision>
  </link>
  <!-- j2 : 底座旋转 (整臂偏航), 范围大 -->
  <joint
    name="base_rotate_joint"
    type="revolute">
    <origin
      xyz="0 0 0.0504999999999999"
      rpy="1.5707963267949 -1.5707963267949 0" />
    <parent
      link="arm_base" />
    <child
      link="arm_base_rotate" />
    <axis
      xyz="-1 0 0" />
    <limit
      lower="-3.14159"
      upper="3.14159"
      effort="10"
      velocity="6.28" />
    <dynamics
      damping="0.1"
      friction="0.0" />
  </joint>

  <!-- l3 : BC 轴连杆 -->
  <link
    name="link_bc">
    <inertial>
      <origin
        xyz="0.0165075601084717 0.0473372214162494 -0.00476164013502745"
        rpy="0 0 0" />
      <mass
        value="0.0565655004543067" />
      <inertia
        ixx="0.000103481838185612"
        ixy="5.35024877797434E-06"
        ixz="9.01545719378009E-07"
        iyy="1.5531248902396E-05"
        iyz="-4.46160971196172E-06"
        izz="0.000106991404292056" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="../meshes/link_bc.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.698039215686274 0.698039215686274 0.698039215686274 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="../meshes/link_bc.STL" />
      </geometry>
    </collision>
  </link>
  <!-- j3 : B 轴 -->
  <joint
    name="axis_B_joint"
    type="revolute">
    <origin
      xyz="0.055999999999994 0.000382836228957711 -0.0194205883228549"
      rpy="0 -1.09630311786825 -1.5707963267949" />
    <parent
      link="arm_base_rotate" />
    <child
      link="link_bc" />
    <axis
      xyz="-1 0 0" />
    <limit
      lower="-2.61799"
      upper="2.61799"
      effort="10"
      velocity="6.28" />
    <dynamics
      damping="0.1"
      friction="0.0" />
  </joint>

  <!-- l4 : CD 轴连杆 -->
  <link
    name="link_cd">
    <inertial>
      <origin
        xyz="-0.0154905535289683 0.0154928277803316 -0.0387592194782328"
        rpy="0 0 0" />
      <mass
        value="0.0370929114993028" />
      <inertia
        ixx="7.10283674427326E-05"
        ixy="-4.5211030823379E-07"
        ixz="6.62959517460371E-06"
        iyy="7.16905054596082E-05"
        iyz="1.24835133153328E-06"
        izz="1.19965985824017E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="../meshes/link_cd.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.698039215686274 0.698039215686274 0.698039215686274 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="../meshes/link_cd.STL" />
      </geometry>
    </collision>
  </link>
  <!-- j4 : C 轴 -->
  <joint
    name="axis_C_joint"
    type="revolute">
    <origin
      xyz="0.0294500000000001 0.119941950317014 0.00373209782198392"
      rpy="0 0 0" />
    <parent
      link="link_bc" />
    <child
      link="link_cd" />
    <axis
      xyz="-1 0 0" />
    <limit
      lower="-2.61799"
      upper="2.61799"
      effort="10"
      velocity="6.28" />
    <dynamics
      damping="0.1"
      friction="0.0" />
  </joint>

  <!-- l5 : 夹爪底座 (腕) -->
  <link
    name="gripper_base">
    <inertial>
      <origin
        xyz="-0.0127955166339258 0.00164606748967253 -0.0358672320062111"
        rpy="0 0 0" />
      <mass
        value="0.0451108540987195" />
      <inertia
        ixx="7.57908726441243E-06"
        ixy="-2.4818388132777E-09"
        ixz="-2.07456260561648E-09"
        iyy="8.89833111624145E-06"
        iyz="-6.04340945150484E-09"
        izz="6.62883706822181E-06" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="../meshes/gripper_base.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.698039215686274 0.698039215686274 0.698039215686274 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="../meshes/gripper_base.STL" />
      </geometry>
    </collision>
  </link>
  <!-- j5 : D 轴 (腕) — 行程很小 ±0.1rad (±5.7°), 近似固定。按真实机构调整。 -->
  <joint
    name="axis_D_joint"
    type="revolute">
    <origin
      xyz="0.000800000000000052 0.00740154405860555 -0.119771520594624"
      rpy="0 0 0" />
    <parent
      link="link_cd" />
    <child
      link="gripper_base" />
    <axis
      xyz="-1 0 0" />
    <limit
      lower="-0.1"
      upper="0.1"
      effort="10"
      velocity="6.28" />
    <dynamics
      damping="0.1"
      friction="0.0" />
  </joint>

  <!-- l6 : 右夹爪 -->
  <link
    name="gripper_right">
    <inertial>
      <origin
        xyz="-0.00432176468119913 -0.0252742057141876 -0.0184063965063959"
        rpy="0 0 0" />
      <mass
        value="0.0109055720487606" />
      <inertia
        ixx="3.28665820700347E-06"
        ixy="-4.28740187441565E-09"
        ixz="-2.67223390999308E-09"
        iyy="1.31774168753248E-06"
        iyz="-1.09912619891086E-06"
        izz="2.07422125329032E-06" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="../meshes/gripper_right.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.698039215686274 0.698039215686274 0.698039215686274 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="../meshes/gripper_right.STL" />
      </geometry>
    </collision>
  </link>
  <!-- j6 : 右指开合 -->
  <joint
    name="gripper_right_joint"
    type="revolute">
    <origin
      xyz="0.00570000000000484 -0.0153749950368713 -0.0238970337472262"
      rpy="1.09630311786825 0 1.5707963267949" />
    <parent
      link="gripper_base" />
    <child
      link="gripper_right" />
    <!-- 采用 revolute 夹爪: 两指网格非镜像, 平移式 (prismatic) 平行夹爪对不齐;
         revolute 已验证能夹住 (contact_grasp 2.2)。平行夹爪留待 sim-to-real 阶段用镜像网格重做。 -->
    <axis
      xyz="-1 0 0" />
    <limit
      lower="-0.8"
      upper="0.8"
      effort="1"
      velocity="6.28" />
    <dynamics
      damping="0.05"
      friction="0.0" />
  </joint>

  <!-- l7 : 左夹爪 -->
  <!-- 镜像修复: 原 gripper_left.STL 与 gripper_right.STL 是两个不同形状 (面数/质量都不同), 并非镜像 → 两指合不拢、平行夹爪对不齐。
       改法: 左指改用右指网格 + scale="-1 1 1" (沿局部 X 镜像) + 关节 yaw 取反 → 左指成为右指的真镜像。惯量也同步改成右指惯量的镜像 (origin.x、ixy、ixz 取反)。 -->
  <link
    name="gripper_left">
    <inertial>
      <origin
        xyz="0.00432176468119913 -0.0252742057141876 -0.0184063965063959"
        rpy="0 0 0" />
      <mass
        value="0.0109055720487606" />
      <inertia
        ixx="3.28665820700347E-06"
        ixy="4.28740187441565E-09"
        ixz="2.67223390999308E-09"
        iyy="1.31774168753248E-06"
        iyz="-1.09912619891086E-06"
        izz="2.07422125329032E-06" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <!-- 镜像: 右指网格 + scale="-1 1 1" → 左指 = 右指的镜像 -->
        <mesh
          filename="../meshes/gripper_right.STL"
          scale="-1 1 1" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.698039215686274 0.698039215686274 0.698039215686274 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="../meshes/gripper_right.STL"
          scale="-1 1 1" />
      </geometry>
    </collision>
  </link>
  <!-- j7 : 左指开合 -->
  <joint
    name="gripper_left_joint"
    type="revolute">
    <!-- 镜像: yaw 1.5707963 → -1.5707963 (配合上面 mesh scale="-1 1 1")。推导: Rot_左=diag(-1,1,1)·Rot_右·diag(-1,1,1)。axis 仍为 (-1 0 0) 不变 (在新坐标系下已指向正确镜像方向)。 -->
    <origin
      xyz="-0.0312999999999952 -0.0153749950368713 -0.0238970337472262"
      rpy="1.09630311786825 0 -1.5707963267949" />
    <parent
      link="gripper_base" />
    <child
      link="gripper_left" />
    <!-- 采用 revolute 夹爪: 同右指, 恢复原 axis/限位。 -->
    <axis
      xyz="-1 0 0" />
    <limit
      lower="-0.8"
      upper="0.8"
      effort="1"
      velocity="6.28" />
    <dynamics
      damping="0.05"
      friction="0.0" />
  </joint>

</robot>
